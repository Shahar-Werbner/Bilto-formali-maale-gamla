// Prisma schema — Maale Gamla attendance system (Phase 1)
// Models mirror the brief. `passwordHash` was added to User to support
// password-based login (see README — auth decision). The `role` field is a
// plain String seeded to "staff" so a future "parent" role can be added
// without a structural migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pools connections; migrations need a direct (non-pooled) URL.
  // If you only have one URL, point both at it.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  name           String
  // "admin" | "staff" (| "parent", planned). Only admins may delete an event or
  // a child, or change anyone's role.
  role           String             @default("staff")
  passwordHash   String?
  attendance     AttendanceRecord[] @relation("MarkedBy")
  eventMarks     EventAttendance[]  @relation("EventMarkedBy")
  dismissalMarks Dismissal[]        @relation("DismissalMarkedBy")
  shifts         Shift[]
  approvedSlots  ActivitySlot[]     @relation("SlotApprovedBy")
  activities     Activity[]         @relation("ActivityCreatedBy")
  activityVotes  ActivityRating[]
  regReviews     Registration[]     @relation("RegistrationReviewedBy")
  createdAt      DateTime           @default(now())
}

model Group {
  id   String @id @default(cuid())
  name String

  // Two kinds of grouping, and the project owner decided (19.09) to keep both.
  //
  // `participants` is the standing membership — "Yael is in the Lions this
  // year". `dayAssignments` is what actually happened on one session, which
  // here changes from week to week.
  //
  // The standing membership is a default to fill a session *from*, never what a
  // session displays: a day with no assignments means "not split yet", not
  // "everyone is in their permanent group".
  participants   Participant[]        @relation("GroupMembers")
  activitySlots  ActivitySlot[]
  dayAssignments DayGroupAssignment[]

  // Soft delete, for the same reason Event and Participant have one, and for a
  // reason that only appeared once per-session groups existed: a group is no
  // longer just a label, it is part of the record of what happened on a day.
  // Hard-deleting one cascaded away every past assignment pointing at it, so a
  // session that had three children rendered as one — deleting in the present
  // silently rewrote the past. With `deletedAt` the group leaves every screen,
  // past sessions still show it, and /admin can restore it.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([deletedAt])
}

model Participant {
  id        String  @id @default(cuid())
  name      String
  grade     String? // כיתה — e.g. "א'", "ה'2"; optional so it can be filled later
  sortOrder Int     @default(0) // legacy: no longer written; lists sort by grade

  // Emergency contact. Staff need to reach a parent in one tap on a trip.
  parentName  String?
  parentPhone String?
  phone       String? // the child's own phone, for the older ones

  // Soft delete: this row carries a child's whole attendance history, and the
  // delete button lives on a phone. `deletedAt` set = hidden everywhere.
  deletedAt DateTime?

  // Who may take this child home, standing instruction. "escort" means an adult
  // has to collect them; "alone" means they may leave by themselves. The column
  // defaults to "escort" on purpose — a child with nothing recorded waits for an
  // adult. The unsafe direction must never be the one you get by forgetting.
  defaultDismissal String @default("escort")

  groups        Group[]               @relation("GroupMembers")
  attendance    AttendanceRecord[]
  events        Event[]               @relation("EventParticipants")
  eventMarks    EventAttendance[]
  pickupAuth    PickupAuthorization[]
  dismissals    Dismissal[]
  dayGroups     DayGroupAssignment[]
  parentLinks   ParentLink[]
  expected      ExpectedAttendance[]
  registrations Registration[]
  createdAt     DateTime              @default(now())

  @@index([deletedAt])
}

model AttendanceRecord {
  id             String      @id @default(cuid())
  date           DateTime    @db.Date
  status         String // "present" | "late" | "absent"
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  markedByUserId String?
  markedBy       User?       @relation("MarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([date, participantId])
  @@index([date])
}

// ── Events ──────────────────────────────────────────────────────────────────
// An Event spans a date range and owns the concrete days attendance is taken
// on. Two shapes, chosen by `kind`:
//   "camp"      — every day in the range (weekends skipped unless included),
//                 all running the event's default hours.
//   "recurring" — only the weekdays listed in `weekdays`, each with its own
//                 hours. This is what a school year looks like here: every
//                 Tuesday 16:00–19:00 and every Friday 09:00–13:00, one event.
// Each event has its own selected list of participants.

model Event {
  id        String   @id @default(cuid())
  name      String
  // "recurring" | "camp". A plain String for the same reason User.role is:
  // another shape can be added without a structural migration.
  kind      String   @default("camp")
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // camp only — the weekend checkboxes and the hours every generated day gets.
  includeFriday    Boolean @default(false)
  includeSaturday  Boolean @default(false)
  defaultStartTime String? // "HH:mm"
  defaultEndTime   String? // "HH:mm"

  // recurring only — one row per weekday the event runs on.
  weekdays EventWeekday[]

  // Staffing alert (item 4): how many children one counselor may cover before a
  // session is flagged as short-staffed. Named for what it measures rather than
  // "threshold", which does not say which direction is the bad one. null = fall
  // back to the app-wide default; a camp and a Tuesday afternoon can want
  // different numbers, so it lives per event.
  maxChildrenPerStaff Int?

  deletedAt    DateTime? // soft delete — see Participant.deletedAt
  participants Participant[]     @relation("EventParticipants")
  days         EventDay[]
  registration RegistrationForm?
  createdAt    DateTime          @default(now())

  @@index([deletedAt])
}

// One weekday of a recurring event's pattern, with the hours it runs.
// A table rather than an Int[] because each weekday needs its own hours:
// "Tue 16:00–19:00, Fri 09:00–13:00" cannot be expressed by a list of numbers.
model EventWeekday {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Sunday … 6=Saturday, matching JS getUTCDay()
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  @@unique([eventId, weekday])
  @@index([eventId])
}

model EventDay {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  description String? // תיאור פעילות — free text, later AI-generated (general note)

  // Copied from the event's template when the day is generated, and editable
  // for a single day without touching the template. Staff hours are derived
  // from these, so they are per-day data, not display.
  startTime String? // "HH:mm"
  endTime   String? // "HH:mm"

  // What to bring on this day only, on top of the event's list (item 8):
  // "בגד ים" on the pool day. Plain strings — see RegistrationForm.equipment.
  equipment String[] @default([])

  attendance       EventAttendance[]
  activitySlots    ActivitySlot[]
  dismissals       Dismissal[]
  groupAssignments DayGroupAssignment[]
  shifts           Shift[]
  expected         ExpectedAttendance[]
  registrationDays RegistrationDay[]
  createdAt        DateTime             @default(now())

  @@unique([eventId, date])
  @@index([eventId])
  @@index([date])
}

model EventAttendance {
  id             String      @id @default(cuid())
  eventDayId     String
  eventDay       EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status         String // "present" | "late" | "absent"
  markedByUserId String?
  markedBy       User?       @relation("EventMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([eventDayId, participantId])
  @@index([eventDayId])
  @@index([participantId])
}

// A structured schedule slot within an event-day (סדר יום). Optional groupId
// targets the slot to a specific group (parallel activities); null = whole event.
model ActivitySlot {
  id         String   @id @default(cuid())
  eventDayId String
  eventDay   EventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  startTime  String // "HH:mm"
  endTime    String? // "HH:mm", optional
  title      String
  location   String?
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notes      String?
  order      Int      @default(0)

  // The approval loop (item 4). A youth counselor plans the activity they are
  // assigned to; an adult signs it off. Without somewhere to hold "waiting",
  // youth had to be given view-only access to the schedule, which is less than
  // the operation actually wants.
  //
  // "approved" | "pending" | "draft". A plain String for the same reason
  // User.role and Event.kind are.
  //
  // The default is "approved", and it is the whole reason this is safe to add
  // to a live schedule: without it every slot that already exists — and every
  // slot an adult creates from now on — would silently become "waiting for
  // approval". For someone who may edit the schedule, the approval is implied
  // by the act of creating the row. Only a slot written by someone who needs
  // sign-off is set to "pending", explicitly, by the route that writes it.
  status           String    @default("approved")
  approvedByUserId String?
  approvedBy       User?     @relation("SlotApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  // Item 7: the bank activity this slot was taken from, if any. Optional —
  // lunch, arrival and most of a day are not bank activities, and a slot keeps
  // its own title/notes either way, so editing the bank entry later never
  // rewrites what a past session says it did. SetNull only matters for a hard
  // delete, which nothing does: activities are archived (Activity.deletedAt).
  activityId String?
  activity   Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  ratings    ActivityRating[]

  createdAt DateTime @default(now())

  @@index([eventDayId])
  @@index([groupId])
  @@index([activityId])
  // The review screen's question: what on this day is waiting for me.
  @@index([status])
}

// ── Dismissal (wave 3, item 2) ──────────────────────────────────────────────
// The children are 6–9. Who collects them is safety-critical, not a
// convenience, so it is modelled in two halves: who is *allowed* to (standing),
// and what actually *happened* at the end of a session (per day).

// A person cleared to collect this child. Standing, not per-day.
model PickupAuthorization {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  relation      String? // "אמא", "סבתא", "שכנה"
  createdAt     DateTime    @default(now())

  @@index([participantId])
}

// What happened at the end of one session for one child: left alone, or
// collected, and by whom. This is the counterpart to attendance — signing out,
// not only in. One row per (day, child), like EventAttendance.
model Dismissal {
  id             String      @id @default(cuid())
  eventDayId     String
  eventDay       EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  method         String // "alone" | "escort"
  pickedUpByName String? // who actually collected them
  at             DateTime?
  note           String? // a one-off change: "today grandma"
  markedByUserId String?
  markedBy       User?       @relation("DismissalMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([eventDayId, participantId])
  @@index([eventDayId])
  @@index([participantId])
}

// ── Per-session groups (wave 3, item 3) ─────────────────────────────────────
// Groups are re-formed each session, so membership belongs to the day rather
// than to the child. `Group` stays as the reusable name the slots point at.
model DayGroupAssignment {
  id            String      @id @default(cuid())
  eventDayId    String
  eventDay      EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  groupId       String
  // Deleting a group clears that day's assignments to it rather than blocking
  // the delete: a group is a reusable name, and today's roster should not make
  // an old name undeletable forever. The children themselves are untouched,
  // which is how deleting a group already behaves.
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([eventDayId, participantId]) // one group per child per day
  @@index([eventDayId])
  @@index([groupId])
}

// ── Staff roster (wave 3, item 4) ───────────────────────────────────────────
// Who is working a given session. Hours default to the session's own hours
// (EventDay.startTime/endTime, wave 3 item 1) and can be overridden per shift,
// which is what the monthly hours report (item 6) is derived from.
model Shift {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventDayId String
  eventDay   EventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  startTime  String? // "HH:mm" — null means "the session's hours"
  endTime    String?
  role       String? // "אחראי", "מדריך קבוצה"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, eventDayId])
  @@index([eventDayId])
  @@index([userId])
}

// ── Parents (wave 3, item 5) ────────────────────────────────────────────────
//
// There are no parent accounts, and that is a decision rather than a shortcut:
// fifty families will not keep passwords for a Tuesday afternoon, and a login
// used twice a year is a login that has been lost by November. Instead each
// family gets a personal link carrying a long random token, the way a calendar
// subscription link works.
//
// What that costs is that everything a parent writes arrives **unauthenticated**
// — the token is the entire proof. The shape below is what makes that
// survivable: the link is a row that can be revoked on its own, and the only
// thing a link can write is one boolean and one short note about one child.

model ParentLink {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // 256 bits, base64url (see src/lib/parents.ts). Stored as it is sent rather
  // than hashed, deliberately: the staff screen has to be able to show "copy
  // link" again next month, because parents lose WhatsApp messages and change
  // phones, and a link that can only ever be displayed once turns every such
  // parent into a re-issue. The token guards one child's coming/not-coming and
  // a short note — not an account, not the roster, not anyone's contacts.
  token String @unique

  // Whose link this is — "אמא", "אבא", "סבתא". A separated couple needs two
  // links, and two links are also what lets one of them be revoked without
  // cutting off the other. Free text because family shapes are not an enum.
  label String?

  // Revoked rather than deleted: the row is what stops the same token being
  // issued again, and "this link was turned off on the 3rd" is a thing an
  // adult may need to see later.
  revokedAt DateTime?

  // Whether anyone ever opened it. Without this, a parent who never answers is
  // indistinguishable from a parent whose link never arrived — and the second
  // one is a WhatsApp message to re-send, not a phone call to make.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([participantId])
}

// One parent's answer for one child on one day: are they coming, and anything
// they want the staff to know. Unique on (day, child) like EventAttendance —
// this is the "before" to that table's "after".
//
// The expected head count is derived from this, and it is what the kitchen
// cooks to and what the staffing alert reads (item 4). The derivation lives in
// src/lib/parents.ts, along with the rule that matters: silence means coming.
model ExpectedAttendance {
  id            String      @id @default(cuid())
  eventDayId    String
  eventDay      EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  coming Boolean

  // Item 8: is the child bringing their own food on this day. null = nobody
  // said (every answer that came through item 5's link, which does not ask).
  // The kitchen cooks for the children who are coming and are not bringing.
  bringsFood Boolean?

  // The parent's own words, usually the one-off pickup change ("היום סבתא
  // אוספת"). It lives here and NOT on Dismissal.note, which is where the
  // original spec put it, for two reasons that only showed up against the
  // code: a Dismissal row existing at all is what the end-of-day screen reads
  // as "this child has gone", so a parent's morning message would mark a
  // six-year-old as released before they had left; and writing it there would
  // walk straight past the rule (item 2) that a one-off change needs an adult.
  //
  // So the message lands here, the dismissal screen shows it as something a
  // parent said, and the adult who signs the child out is the one who turns it
  // into a Dismissal — through the existing gate, unchanged.
  note String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([eventDayId, participantId])
  @@index([eventDayId])
  @@index([participantId])
}

// ── Activity bank (wave 3, item 7) ──────────────────────────────────────────
// Youth counselors rotate every year or two, and what they learned about which
// activity works with 7-year-olds leaves with them. The bank is where that
// stays: an activity is written once, picked into a day's schedule from here,
// and rated after it ran. The ratings are the point — without them this is one
// more list nobody reads.
model Activity {
  id              String   @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int?
  materials       String?
  // Free labels: "חוץ", "יצירה", "גשם", "אנרגיה גבוהה". A String[] rather than
  // a table because they are filters, not entities — nobody renames a tag.
  tags            String[]
  // Grade range as the same free-text grade the roster uses ("א'", "ג'"),
  // compared through gradeRank(). null on either end = open on that end.
  minGrade        String?
  maxGrade        String?

  createdByUserId String?
  createdBy       User?   @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Archived rather than deleted: past sessions point at it and its ratings are
  // the whole value of the row. Archived = out of the picker and the AI's list,
  // still readable where a past slot shows it, and restorable from the bank.
  deletedAt DateTime?

  slots   ActivitySlot[]
  ratings ActivityRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

// One person's verdict on one run of an activity: a specific slot on a
// specific day. Tied to the run rather than only to the activity because
// "didn't work" on a rainy camp day and "didn't work" on a Tuesday are
// different facts, and because it is what makes the rating un-repeatable —
// one vote per person per run, changeable, not one more every time you tap.
model ActivityRating {
  id             String        @id @default(cuid())
  activityId     String
  activity       Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Both SetNull, not Cascade, and on purpose: the rating is the organisational
  // memory this item exists for. A counselor whose account is removed when they
  // leave, or a slot deleted from a past day, must not take the verdict with
  // them — that is exactly the knowledge walking out of the door.
  activitySlotId String?
  activitySlot   ActivitySlot? @relation(fields: [activitySlotId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // "worked" | "flopped" | "wrong_age". A plain String like every other enum
  // here; the vocabulary lives in src/lib/activities.ts.
  verdict        String
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // One vote per person per run, changeable. Postgres treats NULLs as distinct,
  // so orphaned rows (user or slot gone) never collide with each other.
  @@unique([activitySlotId, userId])
  @@index([activityId])
}

// ── Registration (wave 3, item 8) ───────────────────────────────────────────
//
// One fixed form in code, parameterised per event — not a form builder. The
// answers have to feed the system (the roster, the event, the expected count,
// who goes home with whom), and arbitrary fields stored as a blob cannot.
//
// The link is sent once to the parents' WhatsApp group, so it identifies
// nobody: anyone holding it can pick any child from the list. Everything below
// is shaped by that. What a submission may change on its own is the event's
// numbers; anything about who takes a child home, or a child who is not on the
// roster yet, waits for an adult. The rules live in src/lib/registration.ts.

// The event's registration settings and its link. One per event.
model RegistrationForm {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Same shape and the same reasoning as ParentLink.token: 256 bits, stored as
  // sent so the staff can copy the link again. "Turn off and issue a new one"
  // replaces it, and the old one stops resolving at once.
  token String @unique

  intro       String? // the opening text the staff write
  price       String? // free text: "50 ₪", "50 ₪ לילד, 80 לשניים"
  capacity    Int? // null = no cap
  // Approve straight away (the default — registration happens the evening
  // before, and nobody approves forty rows at 22:00) or wait for an adult (a
  // camp with a cap or a fee). A new child and any change to who goes home
  // wait for an adult either way.
  autoApprove Boolean @default(true)

  // Open from openedAt (the moment the link is sent) until whichever comes
  // first: closesAt, a moment in time the staff enter in Israel time, or
  // closedAt, the manual "close registration" button.
  openedAt DateTime?
  closesAt DateTime?
  closedAt DateTime?

  // What to bring, for the whole event. Strings, not a table: there is nothing
  // to join it to, and nobody renames "כובע". Per-day additions live on
  // EventDay.equipment. Every event starts empty — there is no default list.
  equipment          String[]  @default([])
  // Last change to either list. Shown as "עודכן" when it is after openedAt,
  // so a parent who comes back to the link sees that something changed.
  equipmentUpdatedAt DateTime?

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One child's registration to one event. A family with two children sends one
// form and gets two rows: each child is handled on their own — matched,
// counted against the cap, approved — because one sibling coming and the other
// not is the ordinary case.
model Registration {
  id     String           @id @default(cuid())
  formId String
  form   RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  // The child picked from the list. null for a child typed in as new: they do
  // not exist on the roster until an adult approves them, and then this is set.
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // What was typed for a new child. Kept after approval as the record of what
  // the parent sent.
  childName     String?
  childGrade    String?

  // Who filled this in, and how to reach them. Stored here and NOT copied onto
  // the child's record: the link is shared by the whole group, so writing it
  // through would let anyone make their own number the one the staff ring in
  // an emergency for somebody else's child. For a new child an adult's
  // approval is what moves them onto the roster.
  parentName  String
  parentPhone String

  // How the child goes home, as the parent asked. A request, not an
  // instruction: Participant.defaultDismissal and PickupAuthorization only
  // change when an adult approves (see reviewReasons).
  dismissal      String // "alone" | "escort"
  pickupName     String?
  pickupRelation String?
  pickupPhone    String?

  note         String? // free text for the staff
  equipmentAck Boolean @default(false)

  // "approved" | "pending" | "waitlist" | "rejected". Only "approved" holds a
  // place and reaches ExpectedAttendance; the waiting list is ordered by
  // createdAt, which a resubmission does not move.
  status String

  // What an adult has to look at, beyond the status: "new_child",
  // "dismissal_alone", "new_pickup", "contact_differs". Only differences from
  // what is stored land here — a parent ticking exactly what was already true
  // is not a request. Empty = nothing to review.
  reviewReasons    String[]  @default([])
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User?     @relation("RegistrationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  // A resubmission replaces the answers and bumps this. > 1 = "עודכן".
  revision    Int      @default(1)
  submittedAt DateTime @default(now())

  days RegistrationDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One registration per child per event. Postgres treats NULLs as distinct,
  // so any number of not-yet-approved new children fit alongside.
  @@unique([formId, participantId])
  @@index([formId, status])
  @@index([participantId])
}

// The per-day answers of one registration. Held here, and copied into
// ExpectedAttendance only while the registration is approved: a pending or
// waiting-list child must not be counted, and a new child has no Participant
// row to hang an ExpectedAttendance on yet.
model RegistrationDay {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventDayId     String
  eventDay       EventDay     @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  coming         Boolean
  bringsFood     Boolean? // only asked when coming

  @@unique([registrationId, eventDayId])
  @@index([eventDayId])
}
