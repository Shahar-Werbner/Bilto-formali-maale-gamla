# ---------------------------------------------------------------------------
# Database (Postgres — Neon via Vercel integration)
# In Vercel + Neon you typically get DATABASE_URL (pooled) and
# DIRECT_URL / *_URL_NON_POOLING (direct). Prisma migrations use DIRECT_URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate a secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Optional — usually auto-detected on Vercel. Set for local dev if needed.
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Self-service staff signup (/register)
# Anyone with this shared code can create a staff account. Share it with the
# team; change it to rotate access. If unset, registration is disabled.
# ---------------------------------------------------------------------------
SIGNUP_CODE="pick-a-shared-team-code"

# ---------------------------------------------------------------------------
# Seed script — the first staff user created by `npm run seed`
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="מנהל/ת"
